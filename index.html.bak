<!DOCTYPE html>
<html lang="vi">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Xử lý hàng rơi rớt</title>
    <link rel="stylesheet" href="style.css">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <!-- Phosphor Icons for UI elements -->
    <script src="https://unpkg.com/@phosphor-icons/web"></script>
    <!-- Google Identity Services cho OAuth 2.0 -->
    <script src="https://accounts.google.com/gsi/client" async defer></script>
</head>

<body>
    <div class="app-container">
        <header>
            <h1><i class="ph-fill ph-google-drive-logo"></i> Drive Gallery</h1>
            <p class="subtitle">Truy cập thư mục công ty với tài khoản Google</p>
        </header>

        <section class="config-panel">
            <h2>Đăng nhập</h2>
            <div class="input-group" style="justify-content: center;">
                <button id="authBtn" class="primary-btn"><i class="ph ph-google-logo"></i> Đăng nhập bằng
                    Google</button>
            </div>
            <div class="hint">Nhớ đăng nhập bằng Email công ty nhé</div>
        </section>

        <section class="gallery-section">
            <div class="search-bar">
                <i class="ph ph-magnifying-glass"></i>
                <input type="text" id="searchInput" placeholder="Tìm kiếm theo tên file..." disabled>
            </div>

            <div id="loader" class="loader hidden">
                <i class="ph ph-spinner-gap icon-spin"></i> Đang tải dữ liệu...
            </div>

            <div id="errorMessage" class="error-message hidden"></div>

            <div class="list-container">
                <div class="list-header">
                    <div class="col-image">Hình Ảnh</div>
                    <div class="col-name">Tên File</div>
                </div>
                <ul id="imageList" class="image-list">
                    <!-- Các mục hình ảnh sẽ được chèn vào đây bởi JavaScript -->
                </ul>
                <div id="emptyState" class="empty-state hidden">
                    <i class="ph ph-image-broken"></i>
                    <p>Không tìm thấy hình ảnh nào</p>
                </div>
            </div>
        </section>

        <footer>
            <p class="subtitle1">Developer by Thái Dân</p>
        </footer>
    </div>

    <script src="app.js"></script>
</body>

</html>