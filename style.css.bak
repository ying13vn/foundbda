:root {
    --bg-color: #0f172a;
    --surface-color: rgba(30, 41, 59, 0.7);
    --surface-hover: rgba(51, 65, 85, 0.8);
    --text-primary: #f8fafc;
    --text-secondary: #94a3b8;
    --accent-color: #3b82f6;
    --accent-hover: #2563eb;
    --border-color: rgba(255, 255, 255, 0.1);
    --error-color: #ef4444;
    --success-color: #10b981;
}

* {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
}

body {
    font-family: 'Inter', sans-serif;
    background-color: var(--bg-color);
    color: var(--text-primary);
    min-height: 100vh;
    display: flex;
    justify-content: center;
    background-image: radial-gradient(circle at top right, #1e1b4b, transparent 40%),
                      radial-gradient(circle at bottom left, #0f172a, transparent 40%);
}

.app-container {
    width: 100%;
    max-width: 900px;
    padding: 2rem;
    display: flex;
    flex-direction: column;
    gap: 2rem;
}

header {
    text-align: center;
    margin-bottom: 1rem;
}

header h1 {
    font-size: 2.5rem;
    font-weight: 700;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.75rem;
    background: linear-gradient(to right, #60a5fa, #a78bfa);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
}

.subtitle {
    color: var(--text-secondary);
    margin-top: 0.5rem;
    font-size: 1.1rem;
}

.subtitle1 {
    color: var(--text-secondary);
    margin-top: 0.5rem;
    font-size: 0.8rem;
    text-align: center;
}
.config-panel {
    background: var(--surface-color);
    backdrop-filter: blur(12px);
    border: 1px solid var(--border-color);
    border-radius: 16px;
    padding: 1.5rem;
    box-shadow: 0 10px 25px -5px rgba(0, 0, 0, 0.5);
}

.config-panel h2 {
    font-size: 1.25rem;
    margin-bottom: 1rem;
    color: var(--text-primary);
}

.input-group {
    display: flex;
    gap: 1rem;
    flex-wrap: wrap;
}

.input-wrapper {
    position: relative;
    flex: 1;
    min-width: 250px;
}

.input-wrapper i {
    position: absolute;
    left: 1rem;
    top: 50%;
    transform: translateY(-50%);
    color: var(--text-secondary);
    font-size: 1.25rem;
}

input {
    width: 100%;
    background: rgba(15, 23, 42, 0.6);
    border: 1px solid var(--border-color);
    border-radius: 8px;
    padding: 0.75rem 1rem 0.75rem 3rem;
    color: var(--text-primary);
    font-family: inherit;
    font-size: 1rem;
    transition: all 0.3s ease;
}

input:focus {
    outline: none;
    border-color: var(--accent-color);
    box-shadow: 0 0 0 3px rgba(59, 130, 246, 0.2);
}

input:disabled {
    opacity: 0.5;
    cursor: not-allowed;
}

.primary-btn {
    background: var(--accent-color);
    color: white;
    border: none;
    border-radius: 8px;
    padding: 0.75rem 1.5rem;
    font-family: inherit;
    font-size: 1rem;
    font-weight: 600;
    cursor: pointer;
    transition: background-color 0.2s, transform 0.1s;
}

.primary-btn:hover {
    background: var(--accent-hover);
}

.primary-btn:active {
    transform: scale(0.98);
}

.hint {
    margin-top: 0.75rem;
    font-size: 0.85rem;
    color: var(--text-secondary);
    text-align: center;
}

.gallery-section {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
}

.search-bar {
    position: relative;
}

.search-bar i {
    position: absolute;
    left: 1rem;
    top: 50%;
    transform: translateY(-50%);
    color: var(--text-secondary);
    font-size: 1.25rem;
}

.search-bar input {
    background: var(--surface-color);
    backdrop-filter: blur(12px);
    font-size: 1.1rem;
    padding: 1rem 1rem 1rem 3.5rem;
    border-radius: 12px;
}

.list-container {
    background: var(--surface-color);
    backdrop-filter: blur(12px);
    border: 1px solid var(--border-color);
    border-radius: 16px;
    overflow: hidden;
    box-shadow: 0 10px 25px -5px rgba(0, 0, 0, 0.5);
}

.list-header {
    display: flex;
    padding: 1rem 1.5rem;
    background: rgba(0, 0, 0, 0.2);
    border-bottom: 1px solid var(--border-color);
    font-weight: 600;
    color: var(--text-secondary);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    font-size: 0.85rem;
}

.col-image {
    width: 120px;
    flex-shrink: 0;
}

.col-name {
    flex-grow: 1;
    padding-left: 1.5rem;
}

.image-list {
    list-style: none;
    max-height: 600px;
    overflow-y: auto;
}

/* Tùy chỉnh thanh cuộn */
.image-list::-webkit-scrollbar {
    width: 8px;
}
.image-list::-webkit-scrollbar-track {
    background: rgba(0,0,0,0.1);
}
.image-list::-webkit-scrollbar-thumb {
    background: var(--surface-hover);
    border-radius: 4px;
}

.list-item {
    display: flex;
    align-items: center;
    padding: 1rem 1.5rem;
    border-bottom: 1px solid var(--border-color);
    transition: background-color 0.2s ease;
    animation: fadeIn 0.4s ease forwards;
    opacity: 0;
}

.list-item:hover {
    background-color: var(--surface-hover);
}

.list-item:last-child {
    border-bottom: none;
}

.item-image {
    width: 120px;
    height: 80px;
    flex-shrink: 0;
    border-radius: 8px;
    overflow: hidden;
    background: #000;
    display: flex;
    align-items: center;
    justify-content: center;
}

.item-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.3s ease;
}

.item-image:hover img {
    transform: scale(1.1);
}

.item-name {
    flex-grow: 1;
    padding-left: 1.5rem;
    font-weight: 500;
    word-break: break-all;
}

.loader {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    padding: 2rem;
    color: var(--accent-color);
    font-weight: 500;
}

.icon-spin {
    animation: spin 1s linear infinite;
}

.error-message {
    background: rgba(239, 68, 68, 0.1);
    color: var(--error-color);
    padding: 1rem;
    border-radius: 8px;
    border: 1px solid rgba(239, 68, 68, 0.3);
    text-align: center;
}

.empty-state {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: 3rem;
    color: var(--text-secondary);
    gap: 1rem;
}

.empty-state i {
    font-size: 3rem;
    opacity: 0.5;
}

.hidden {
    display: none !important;
}

@keyframes spin {
    to { transform: rotate(360deg); }
}

@keyframes fadeIn {
    from { opacity: 0; transform: translateY(10px); }
    to { opacity: 1; transform: translateY(0); }
}

@media (max-width: 600px) {
    .app-container {
        padding: 1rem;
    }
    
    .list-header {
        display: none; /* Ẩn header ở mobile để tiết kiệm diện tích */
    }
    
    .list-item {
        flex-direction: column;
        align-items: flex-start;
        gap: 1rem;
    }
    
    .item-name {
        padding-left: 0;
    }
    
    .item-image {
        width: 100%;
        height: 200px;
    }
}
